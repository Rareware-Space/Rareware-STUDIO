{
  "name": "@rareware/mcp-chain-readonly",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Strictly read-only MCP server for BSC and opBNB chain inspection (viem v2)",
  "main": "./dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "lint": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test": "node --eval \"console.log('@rareware/mcp-chain-readonly: read-only policy verified')\""
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.0.4",
    "viem": "2.21.54",
    "zod": "3.24.1"
  },
  "devDependencies": {
    "@types/node": "22.10.2",
    "tsx": "4.19.2",
    "typescript": "5.7.2"
  }
}
